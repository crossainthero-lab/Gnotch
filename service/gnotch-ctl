#!/usr/bin/env python3
"""gnotch-ctl: command-line client for the Gnotch service (also used by tests)."""
import json
import sys

from gi.repository import Gio, GLib

BUS, PATH, IFACE = "org.gnotch.Service1", "/org/gnotch/Service1", "org.gnotch.Service1"


def call(method, fmt="", *args):
    conn = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    v = GLib.Variant(f"({fmt})", args) if fmt else None
    r = conn.call_sync(BUS, PATH, IFACE, method, v, None, Gio.DBusCallFlags.NONE, 60000, None)
    return r.unpack()[0] if r.n_children() else None


def pack(src, out=None):
    """Validate an addon directory and zip it into <id>-<version>.gnotchaddon (no service needed)."""
    import os
    import zipfile
    sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
    from gnotch_service import manifest as mf
    m = mf.load(src)
    out = out or f"{m['id']}-{m['version']}.gnotchaddon"
    skip = {"__pycache__", ".git", ".venv", "node_modules"}
    with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as z:
        for root, dirs, files in os.walk(src):
            dirs[:] = [d for d in dirs if d not in skip]
            for f in files:
                full = os.path.join(root, f)
                z.write(full, os.path.relpath(full, src))
    print(out)


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print("usage: gnotch-ctl list | state | install <dir|pkg> | link <dir> | uninstall <id> [--purge]\n"
              "       enable <id> [--grant-all] | disable <id> | view <id> | action <id> <action> [json]\n"
              "       pack <dir> [out.gnotchaddon] | settings <id> | set <id> <key> <json> | call <id> <method> [json] | shortcuts | rescan\n       open [id] | close   (expand / collapse the notch)")
        return 0
    c, a = argv[0], argv[1:]
    if c == "pack":
        pack(a[0], a[1] if len(a) > 1 else None)
        return 0
    if c == "state":
        print(json.dumps(json.loads(call("GetState")), indent=2))
    elif c == "list":
        for x in json.loads(call("GetState"))["addons"]:
            print(f"{x['id']:40} {x['version']:8} {x['state']:12} {x['error']}")
    elif c == "install":
        print(call("Install", "s", a[0]))
    elif c == "link":
        print(call("Link", "s", a[0]))
    elif c == "uninstall":
        call("Uninstall", "sb", a[0], "--purge" in a)
    elif c == "enable":
        if "--grant-all" in a:
            st = {x["id"]: x for x in json.loads(call("GetState"))["addons"]}
            call("Grant", "sas", a[0], [p["id"] for p in st[a[0]]["permissions"]])
        call("SetEnabled", "sb", a[0], True)
    elif c == "disable":
        call("SetEnabled", "sb", a[0], False)
    elif c == "view":
        print(json.dumps(json.loads(call("GetView", "s", a[0])), indent=2))
    elif c == "action":
        call("Action", "sss", a[0], a[1], a[2] if len(a) > 2 else "{}")
    elif c == "settings":
        print(json.dumps(json.loads(call("GetSettings", "s", a[0])), indent=2))
    elif c == "set":
        call("SetSetting", "sss", a[0], a[1], a[2])
    elif c == "call":
        print(call("CallAddon", "sss", a[0], a[1], a[2] if len(a) > 2 else "{}"))
    elif c == "shortcuts":
        print(json.dumps(json.loads(call("GetShortcuts")), indent=2))
    elif c == "open":
        call("Present", "s", a[0] if a else "*")
    elif c == "close":
        call("Present", "s", "")
    elif c == "rescan":
        call("Rescan")
    else:
        print("unknown command", c, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except GLib.Error as e:
        print(f"error: {e.message}", file=sys.stderr)
        sys.exit(1)
